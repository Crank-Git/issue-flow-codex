{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/preflight.py\"",
            "timeout": 55
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/guard-spawn.py\""
          }
        ]
      },
      {
        "matcher": "wait_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/guard-wait.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/guard-role.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "wait_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/record-wait-state.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/record-wait-state.py\""
          }
        ]
      },
      {
        "matcher": "^mcp__.+__list_(issues|pull_requests)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/record-wait-state.py\""
          }
        ]
      }
    ]
  }
}
